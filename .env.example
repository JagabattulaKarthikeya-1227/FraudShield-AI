# ==============================================================================
# FraudShield AI — Global Environment Configuration Template
# ==============================================================================

# System Environment (development, production, testing)
FLASK_ENV=development
DEBUG=true

# Database (MySQL 8) Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fraudshield_db
MYSQL_USER=fraudshield_user
MYSQL_PASSWORD=fraudshield_secure_pass_2026
MYSQL_ROOT_PASSWORD=root_secure_pass_2026

# Security & Authentication (JWT)
# Generate secure keys in production (e.g. using `openssl rand -hex 32`)
SECRET_KEY=dev_secret_key_change_me_in_production_123456789
JWT_SECRET_KEY=jwt_dev_secret_key_change_me_in_production_987654321
JWT_ACCESS_TOKEN_EXPIRES=900  # 15 minutes (in seconds)
JWT_REFRESH_TOKEN_EXPIRES=86400  # 24 hours (in seconds)

# Flask Server Config
PORT=5000
HOST=0.0.0.0

# Frontend Development Config
VITE_API_URL=http://localhost:5000/api/v1
VITE_PORT=3000

# Email Configuration (Flask-Mail)
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=noreply@fraudshield.ai

# Logging Config
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
